    {
      "key": "risk-register-review",
      "kind": "workflow",
      "name": "Risk Register review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the risk register records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "risk-register-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "default-risk-status",
      "kind": "workflow",
      "name": "Start new risks as identified",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "risk-entries"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_identified"
          ],
          "otherwise": []
        },
        {
          "id": "set_identified",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "risk-entries"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "risk-entries"
                },
                "field": "status",
                "option": "identified"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "escalate-critical-risks",
      "kind": "workflow",
      "name": "Escalate critical risks",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "risk-entries"
        },
        "event": "updated",
        "fields": [
          "rating"
        ],
        "filter": {
          "match": "is",
          "field": "rating",
          "value": {
            "kind": "single-select",
            "option": "critical"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "risk-entries"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "escalated",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        },
        {
          "id": "treat",
          "kind": "human",
          "prompt": "A risk has been rated critical. Agree a treatment plan and owner with leadership, add or update its controls and record a review.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-risk-reviews",
      "kind": "workflow",
      "name": "Flag risks due for review",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "risk-entries"
        },
        "field": {
          "kind": "date",
          "field": "next-review",
          "offset": {
            "direction": "after",
            "amount": 0,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is-not",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "closed"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "risk-entries"
          },
          "row": {
