    {
      "key": "market-research-review",
      "kind": "workflow",
      "name": "Market Research Notes review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the market research notes records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "market-research-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "default-finding-status",
      "kind": "workflow",
      "name": "Start new findings as drafts",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "research-findings"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_draft"
          ],
          "otherwise": []
        },
        {
          "id": "set_draft",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "research-findings"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "research-findings"
                },
                "field": "status",
                "option": "draft"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "log-finding-status",
      "kind": "workflow",
      "name": "Log finding status changes",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "research-findings"
        },
        "event": "updated",
        "fields": [
          "status"
        ]
      },
      "steps": [
        {
          "id": "log",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "finding-review-log"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "input",
                "path": [
                  "values",
                  {
                    "field": "title"
                  }
                ]
              }
            },
            {
              "field": "finding",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "kind",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "finding-review-log"
                },
                "field": "kind",
                "option": "status-change"
              }
            },
            {
              "field": "detail",
              "value": {
                "kind": "literal",
                "value": "Status changed. Check the finding history for the previous value."
              }
            }
          ]
        }
