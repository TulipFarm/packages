        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "research-findings"
          },
          "permissions": [
            "table.row.read"
          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "research-sources"
          },
          "permissions": [
            "table.row.read"
          ]
        }
      ],
      "taskLimits": {
