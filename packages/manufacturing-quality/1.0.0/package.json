  "package": {
    "name": "manufacturing-quality",
    "version": "1.0.0",
    "title": "Quality Nonconformances",
    "description": "Record product nonconformances and corrective and preventive actions (CAPAs), plus automations that open a CAPA for every major nonconformance, flag overdue CAPAs and ask for an effectiveness check before closure.",
    "license": "MIT"
  },
