  "package": {
    "name": "email-newsletter",
    "version": "1.0.0",
    "title": "Email Newsletter Pipeline",
    "description": "Run a recurring email newsletter with one record per issue, a pool of story ideas by section and a results record for each send, plus automations that start new issues in planning, flag late sends and open a results record when an issue is sent.",
    "license": "MIT"
  },
