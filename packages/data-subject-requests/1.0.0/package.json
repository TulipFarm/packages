      "kind": "workflow",
      "name": "Flag overdue privacy requests",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "privacy-requests"
        },
        "field": {
          "kind": "date",
          "field": "deadline",
          "offset": {
            "direction": "after",
            "amount": 1,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is-not",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "completed"
          }
        }
      },
      "steps": [
        {
