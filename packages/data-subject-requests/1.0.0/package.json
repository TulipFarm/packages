    {
      "key": "open-identity-check",
      "kind": "workflow",
      "name": "Open an identity check",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "privacy-requests"
        },
        "event": "created"
