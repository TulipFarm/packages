        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "postmortems"
          },
          "permissions": [
            "table.row.read"
          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "postmortem-actions"
          },
          "permissions": [
            "table.row.read"
