    {
      "key": "procurement-requests-review",
      "kind": "workflow",
      "name": "Purchase Requests review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the purchase requests records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "procurement-requests-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "default-request-status",
      "kind": "workflow",
      "name": "Set new requests to submitted",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "purchase-requests"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_submitted"
          ],
          "otherwise": []
        },
        {
          "id": "set_submitted",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "purchase-requests"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "purchase-requests"
                },
                "field": "status",
                "option": "submitted"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "finance-approval-large",
      "kind": "workflow",
      "name": "Ask finance to approve large requests",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "purchase-requests"
        },
        "event": "updated",
        "fields": [
          "amount-band"
        ],
        "filter": {
          "match": "is",
          "field": "amount-band",
          "value": {
            "kind": "single-select",
            "option": "over-10000"
          }
        }
      },
      "steps": [
        {
          "id": "log_approval",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "purchase-approvals"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "literal",
                "value": "Finance approval for a large purchase"
              }
            },
            {
              "field": "request",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "approver-level",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "purchase-approvals"
                },
                "field": "approver-level",
                "option": "finance"
              }
            },
            {
              "field": "decision",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "purchase-approvals"
                },
                "field": "decision",
                "option": "pending"
              }
            }
          ]
        },
        {
          "id": "finance_decision",
          "kind": "human",
          "prompt": "A purchase request over 10,000 needs finance approval. Check budget and justification, then record the decision on the pending approval.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "draft-po-on-approval",
      "kind": "workflow",
      "name": "Draft a purchase order on approval",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "purchase-requests"
        },
        "event": "updated",
        "fields": [
          "status"
        ],
        "filter": {
          "match": "is",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "approved"
          }
        }
      },
      "steps": [
        {
          "id": "draft_po",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "purchase-orders"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "literal",
                "value": "Purchase order for an approved request"
              }
            },
            {
              "field": "request",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "purchase-orders"
                },
                "field": "status",
                "option": "draft"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    }
