          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "contract-renewals"
          },
          "permissions": [
            "table.row.read"
          ]
        }
      ],
      "slackSender": "user",
      "slackChannels": [],
      "schedules": [],
      "requestedState": "active"
    },
    {
      "key": "contract-tracker-review",
      "kind": "workflow",
      "name": "Contract Renewals and Obligations review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the contract renewals and obligations records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "contract-tracker-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-notice-deadline",
      "kind": "workflow",
      "name": "Flag approaching notice deadlines",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "contracts"
        },
        "field": {
          "kind": "date",
          "field": "notice-deadline",
          "offset": {
            "direction": "before",
            "amount": 30,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "active"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "contracts"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "notice-due",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            },
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "contracts"
                },
                "field": "status",
                "option": "notice-window"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "open-renewal-decision",
      "kind": "workflow",
      "name": "Open a renewal decision",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "contracts"
        },
        "event": "updated",
        "fields": [
          "status"
        ],
        "filter": {
          "match": "is",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "notice-window"
          }
        }
      },
      "steps": [
        {
          "id": "decision",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "contract-renewals"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "input",
                "path": [
                  "values",
                  {
                    "field": "title"
                  }
                ]
              }
            },
            {
              "field": "contract",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "decision",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "contract-renewals"
                },
                "field": "decision",
                "option": "pending"
              }
            }
          ]
        },
        {
          "id": "decide",
          "kind": "human",
          "prompt": "A contract is inside its notice window. Review usage, cost and obligations, choose renew, renegotiate or terminate, and record the decision before the notice deadline.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-overdue-obligations",
      "kind": "workflow",
      "name": "Flag overdue obligations",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "contract-obligations"
        },
        "field": {
          "kind": "date",
          "field": "due",
          "offset": {
            "direction": "after",
            "amount": 1,
            "unit": "days"
          },
          "time": "09:00",
