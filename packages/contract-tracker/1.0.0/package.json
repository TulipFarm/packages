              "invoke"
            ]
          }
        ],
        "personGrants": []
      },
      "enrollment": [
        {
          "kind": "input",
          "inputKind": "team",
          "key": "owning-team"
        }
      ],
      "limits": [
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "contracts"
          },
          "permissions": [
            "table.row.read"
          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "contract-obligations"
          },
          "permissions": [
