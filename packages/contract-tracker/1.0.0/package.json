{
  "$schema": "https://tulipfarm.ai/schemas/system-package.v1.json",
  "formatVersion": 1,
  "package": {
    "name": "contract-tracker",
    "version": "1.0.0",
    "title": "Contract Renewals and Obligations",
    "description": "Track signed contracts, the obligations they create and each renewal decision, plus automations that flag contracts 30 days before their notice deadline, open a renewal decision and flag missed obligations.",
    "license": "MIT"
  },
  "requires": {
    "platform": "tulipfarm-system-package-v1",
    "capabilities": [
      "tables",
      "seed-rows",
      "skills",
      "agents",
      "workflows"
    ]
  },
