{
  "$schema": "https://tulipfarm.ai/schemas/system-package.v1.json",
  "formatVersion": 1,
  "package": {
    "name": "course-planning",
    "version": "1.0.0",
    "title": "Course and Cohort Planning",
    "description": "Plan courses and cohorts with scheduled sessions and learner enrolments, plus automations that set new enrolments to pending, put under-enrolled cohorts up for review and flag sessions with no attendance recorded.",
    "license": "MIT"
  },
  "requires": {
    "platform": "tulipfarm-system-package-v1",
    "capabilities": [
      "tables",
      "seed-rows",
      "skills",
      "agents",
      "workflows"
    ]
  },
