  "formatVersion": 1,
  "package": {
    "name": "tech-debt-register",
    "version": "1.0.0",
    "title": "Tech Debt Register",
    "description": "Record technical debt against the systems it affects, with impact, effort and decisions, plus automations that triage new items, log a decision request for high-impact debt and flag accepted debt for review.",
    "license": "MIT"
  },
  "requires": {
    "platform": "tulipfarm-system-package-v1",
