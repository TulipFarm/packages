    {
      "key": "tech-debt-register-procedure",
      "kind": "skill",
      "files": [
        {
          "path": "SKILL.md",
          "asset": "procedure"
        }
      ],
      "requestedState": "enabled",
      "sharing": {
        "grants": [
          {
            "team": {
              "kind": "input",
              "inputKind": "team",
              "key": "owning-team"
            },
            "permissions": [
              "read",
