    {
      "key": "open-event-tasks",
      "kind": "workflow",
      "name": "Open standard event tasks",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "events"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "venue",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "event-tasks"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "literal",
                "value": "Book the venue"
              }
            },
            {
              "field": "event",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "event-tasks"
                },
                "field": "status",
                "option": "to-do"
              }
            }
          ]
        },
        {
          "id": "run_of_show",
          "kind": "create-row",
          "table": {
