    {
      "key": "vendor-security-reviews-review",
      "kind": "workflow",
      "name": "Vendor Security Reviews review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the vendor security reviews records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "vendor-security-reviews-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "escalate-critical-findings",
      "kind": "workflow",
      "name": "Escalate critical findings",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "vendor-findings"
        },
        "event": "updated",
        "fields": [
          "severity"
        ],
        "filter": {
          "match": "is",
          "field": "severity",
          "value": {
            "kind": "single-select",
            "option": "critical"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "vendor-findings"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "escalated",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        },
        {
          "id": "decide",
          "kind": "human",
          "prompt": "A vendor finding is critical. Decide whether to pause the vendor, agree remediation or accept the risk, and record it on the finding.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-re-review",
      "kind": "workflow",
      "name": "Flag vendors due for re-review",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "security-vendors"
        },
        "field": {
          "kind": "date",
          "field": "next-review",
          "offset": {
            "direction": "after",
            "amount": 1,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is-not",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "rejected"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "security-vendors"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "re-review-due",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "open-new-findings",
      "kind": "workflow",
      "name": "Open new findings",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "vendor-findings"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_open"
          ],
          "otherwise": []
        },
        {
          "id": "set_open",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "vendor-findings"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "vendor-findings"
                },
                "field": "status",
                "option": "open"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    }
  ],
  "assets": [
    {
      "key": "procedure",
