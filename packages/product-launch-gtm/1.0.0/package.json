    {
      "key": "flag-overdue-launch-tasks",
      "kind": "workflow",
      "name": "Flag overdue launch tasks",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "launch-tasks"
        },
        "field": {
          "kind": "date",
          "field": "due",
          "offset": {
            "direction": "after",
            "amount": 1,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is-not",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "done"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "launch-tasks"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "overdue",
              "value": {
