        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "insights"
          },
          "permissions": [
            "table.row.read"
          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "roadmap-releases"
          },
          "permissions": [
            "table.row.read"
          ]
        }
      ],
      "taskLimits": {
        "toolCalls": 40,
        "activeMilliseconds": 180000,
        "credits": 100
      },
      "policy": {
        "grants": [
          {
            "team": {
