    {
      "key": "product-roadmap-review",
      "kind": "workflow",
      "name": "Product Roadmap review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the product roadmap records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "product-roadmap-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "mark-new-insights",
      "kind": "workflow",
      "name": "Mark new insights",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "insights"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_new"
          ],
          "otherwise": []
        },
        {
          "id": "set_new",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "insights"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "insights"
                },
                "field": "status",
                "option": "new"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "log-feature-status",
      "kind": "workflow",
      "name": "Log feature status changes",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "features"
        },
        "event": "updated",
        "fields": [
          "status"
        ]
      },
      "steps": [
        {
          "id": "log",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "feature-updates"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "input",
                "path": [
                  "values",
                  {
                    "field": "name"
                  }
                ]
              }
            },
            {
              "field": "feature",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "kind",
              "value": {
                "kind": "option",
                "table": {
