    {
      "key": "ecommerce-orders-review",
      "kind": "workflow",
      "name": "Order Exceptions and Returns review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the order exceptions and returns records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "ecommerce-orders-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "open-new-exceptions",
      "kind": "workflow",
      "name": "Open new order exceptions",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "order-exceptions"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_open"
          ],
          "otherwise": []
        },
        {
          "id": "set_open",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "order-exceptions"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "order-exceptions"
                },
                "field": "status",
                "option": "open"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-stale-exceptions",
      "kind": "workflow",
      "name": "Flag stale exceptions",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "order-exceptions"
        },
        "field": {
          "kind": "date",
          "field": "opened",
          "offset": {
            "direction": "after",
            "amount": 3,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is-not",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "resolved"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "order-exceptions"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "stale",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "approve-refunds",
      "kind": "workflow",
      "name": "Request refund approval",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "order-returns"
        },
        "event": "updated",
        "fields": [
          "status"
        ],
        "filter": {
          "match": "is",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "received"
          }
        }
      },
      "steps": [
        {
          "id": "pending",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "order-returns"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "refund-approval",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "order-returns"
                },
                "field": "refund-approval",
                "option": "pending"
              }
            }
          ]
        },
        {
          "id": "approve",
          "kind": "human",
          "prompt": "A return has arrived. Check the item, then record the refund approval as approved or declined. Issue any refund in your store tools.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    }
