    {
      "key": "on-call-handoffs-review",
      "kind": "workflow",
      "name": "On-call Handoffs review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the on-call handoffs records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "on-call-handoffs-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "open-handoff-note",
      "kind": "workflow",
      "name": "Open a handoff note",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "oncall-shifts"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "note",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "handoff-notes"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "input",
                "path": [
                  "values",
                  {
                    "field": "title"
                  }
                ]
              }
            },
            {
              "field": "shift",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "handoff-notes"
                },
                "field": "status",
                "option": "to-write"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-unacknowledged",
      "kind": "workflow",
      "name": "Flag unacknowledged handoffs",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "handoff-notes"
        },
        "field": {
          "kind": "date",
          "field": "due",
          "offset": {
            "direction": "after",
            "amount": 1,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is-not",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "acknowledged"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "handoff-notes"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "unacknowledged",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "escalate-critical-alerts",
      "kind": "workflow",
      "name": "Escalate critical alerts",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "open-alerts"
        },
        "event": "updated",
        "fields": [
          "severity"
        ],
        "filter": {
          "match": "is",
          "field": "severity",
          "value": {
            "kind": "single-select",
            "option": "critical"
          }
        }
      },
      "steps": [
        {
          "id": "join",
          "kind": "human",
          "prompt": "An on-call alert is now critical. Join the investigation with the primary and record notes on the alert.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    }
  ],
  "assets": [
    {
      "key": "procedure",
