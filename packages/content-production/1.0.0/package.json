  "formatVersion": 1,
  "package": {
    "name": "content-production",
    "version": "1.0.0",
    "title": "Content Production Line",
    "description": "Move client content from brief to draft to approved with writers and review rounds, plus automations that open a draft for each brief, log draft status changes and flag drafts past due.",
    "license": "MIT"
  },
  "requires": {
    "platform": "tulipfarm-system-package-v1",
    "capabilities": [
      "tables",
      "seed-rows",
      "skills",
      "agents",
      "workflows"
    ]
