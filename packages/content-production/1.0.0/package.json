        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "content-briefs"
          },
          "permissions": [
            "table.row.read"
          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "content-writers"
          },
          "permissions": [
            "table.row.read"
          ]
        }
      ],
      "taskLimits": {
        "toolCalls": 40,
        "activeMilliseconds": 180000,
        "credits": 100
      },
      "policy": {
