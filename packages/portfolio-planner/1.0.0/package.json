    {
      "key": "default-task-status",
      "kind": "workflow",
      "name": "Default task status",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "tasks"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
