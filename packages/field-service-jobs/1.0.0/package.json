            "kind": "resource",
            "resourceKind": "table",
            "key": "service-customers"
          },
          "permissions": [
            "table.row.read"
          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "job-follow-ups"
          },
          "permissions": [
            "table.row.read"
          ]
        }
