    {
      "key": "laptop-provisioning-review",
      "kind": "workflow",
      "name": "Laptop and Device Provisioning review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the laptop and device provisioning records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
