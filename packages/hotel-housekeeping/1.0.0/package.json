    {
      "key": "hotel-housekeeping-review",
      "kind": "workflow",
      "name": "Hotel Housekeeping review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the hotel housekeeping records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "hotel-housekeeping-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "queue-room-inspection",
      "kind": "workflow",
      "name": "Queue a room inspection",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "room-cleaning-tasks"
        },
        "event": "updated",
        "fields": [
          "status"
        ],
        "filter": {
          "match": "is",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "cleaned"
          }
        }
      },
      "steps": [
        {
          "id": "inspection",
          "kind": "create-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "room-inspections"
          },
          "fields": [
            {
              "field": "title",
              "value": {
                "kind": "input",
                "path": [
                  "values",
                  {
                    "field": "title"
                  }
                ]
              }
            },
            {
              "field": "cleaning-task",
              "value": {
                "kind": "input",
                "path": [
                  "recordId"
                ]
              }
            },
            {
              "field": "result",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "room-inspections"
                },
                "field": "result",
                "option": "pending"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "reclean-failed-rooms",
      "kind": "workflow",
      "name": "Send failed rooms back for re-cleaning",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "room-inspections"
        },
        "event": "updated",
        "fields": [
          "result"
        ],
        "filter": {
          "match": "is",
          "field": "result",
          "value": {
            "kind": "single-select",
            "option": "failed"
          }
        }
      },
      "steps": [
        {
          "id": "reassign",
          "kind": "human",
          "prompt": "A room failed inspection. Read the findings, add a re-clean task for a room attendant and record what was missed.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
