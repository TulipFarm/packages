    {
      "key": "hr-policy-questions-review",
      "kind": "workflow",
      "name": "HR Policy Questions review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the hr policy questions records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "hr-policy-questions-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "default-question-status",
      "kind": "workflow",
      "name": "Default new questions to new",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "policy-questions"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_new"
          ],
          "otherwise": []
        },
        {
          "id": "set_new",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "policy-questions"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "policy-questions"
                },
                "field": "status",
                "option": "new"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "route-sensitive-questions",
      "kind": "workflow",
      "name": "Route sensitive questions to HR",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "policy-questions"
        },
        "event": "updated",
        "fields": [
          "sensitivity"
        ],
        "filter": {
          "match": "is",
          "field": "sensitivity",
          "value": {
            "kind": "single-select",
            "option": "sensitive"
          }
        }
      },
      "steps": [
        {
          "id": "escalate",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "policy-questions"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "policy-questions"
                },
                "field": "status",
                "option": "escalated-to-hr"
              }
            }
          ]
        },
        {
          "id": "hr_takeover",
          "kind": "human",
          "prompt": "A policy question was marked sensitive. Take it over, reply to the employee privately and keep personal details out of the record.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-waiting-questions",
      "kind": "workflow",
      "name": "Flag questions left waiting",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "policy-questions"
        },
        "field": {
          "kind": "date",
          "field": "received",
          "offset": {
            "direction": "after",
            "amount": 3,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "new"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "policy-questions"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "waiting",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    }
