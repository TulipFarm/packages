    {
      "key": "seo-keyword-plan-review",
      "kind": "workflow",
      "name": "SEO Keyword Plan review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the seo keyword plan records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "seo-keyword-plan-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "default-keyword-status",
      "kind": "workflow",
      "name": "Start new keywords in research",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "target-keywords"
        },
        "event": "created"
      },
      "steps": [
        {
          "id": "needs_status",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "input",
              "path": [
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "is-empty"
          },
          "ifMet": [
            "set_researching"
          ],
          "otherwise": []
        },
        {
          "id": "set_researching",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "target-keywords"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "status",
              "value": {
                "kind": "option",
                "table": {
                  "kind": "resource",
                  "resourceKind": "table",
                  "key": "target-keywords"
                },
                "field": "status",
                "option": "researching"
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "review-cannibalisation",
      "kind": "workflow",
      "name": "Review keyword cannibalisation",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "target-keywords"
        },
        "event": "updated",
        "fields": [
          "cannibalisation"
        ],
        "filter": {
          "match": "is",
          "field": "cannibalisation",
          "value": {
            "kind": "boolean",
            "value": true
          }
        }
      },
      "steps": [
        {
          "id": "choose_page",
          "kind": "human",
          "prompt": "Two or more pages may be competing for this keyword. Compare them, choose one target page, plan merges or redirects and update the keyword.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "request-page-refresh",
      "kind": "workflow",
      "name": "Request a page refresh",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "seo-target-pages"
        },
        "event": "updated",
        "fields": [
          "status"
        ],
        "filter": {
          "match": "is",
