            },
            {
              "key": "seo",
              "label": "Seo",
              "retired": false
            },
            {
              "key": "compliance",
              "label": "Compliance",
              "retired": false
            }
          ]
        },
        {
          "key": "result",
          "label": "Result",
          "required": false,
          "kind": "single-select",
          "options": [
            {
              "key": "pending",
              "label": "Pending",
              "retired": false
            },
            {
              "key": "pass",
              "label": "Pass",
              "retired": false
            },
            {
              "key": "fail",
              "label": "Fail",
              "retired": false
            }
          ]
        },
        {
          "key": "checked",
          "label": "Checked date",
          "required": false,
          "kind": "date"
        },
        {
          "key": "notes",
          "label": "Notes",
          "required": false,
          "kind": "text",
          "maxLength": 10000
        }
      ],
      "uniqueKeys": [],
      "sharing": {
        "grants": [
          {
            "team": {
              "kind": "input",
              "inputKind": "team",
              "key": "owning-team"
            },
            "permissions": [
              "table.row.read"
            ]
          }
        ],
        "personGrants": []
      }
    },
    {
      "key": "throw",
      "kind": "seed-row",
      "table": {
        "kind": "resource",
        "resourceKind": "table",
        "key": "catalog-products"
      },
      "values": {
        "name": {
          "kind": "text",
          "value": "Example: Linen throw blanket"
        },
        "sku": {
          "kind": "text",
          "value": "LTB-100"
        },
        "category": {
          "kind": "single-select",
          "option": "home"
        },
        "brand": {
          "kind": "text",
          "value": "Example: Hearth & Loom"
        },
        "status": {
          "kind": "single-select",
          "option": "missing-data"
        },
        "owner": {
          "kind": "text",
          "value": "Merchandising lead"
        },
        "launch": {
          "kind": "date",
          "value": "2026-12-01"
        }
      }
    },
