      "owningTeam": {
        "kind": "input",
        "inputKind": "team",
        "key": "owning-team"
      },
      "fields": [
        {
          "key": "title",
          "label": "Check",
          "required": true,
          "kind": "text",
          "maxLength": 2000
        },
        {
          "key": "product",
          "label": "Product",
          "required": true,
          "kind": "relationship",
          "target": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "catalog-products"
          },
          "cardinality": "one",
          "inverseCardinality": "many",
          "reverse": null,
          "onDelete": "restrict"
        },
        {
          "key": "check-type",
          "label": "Check type",
          "required": false,
          "kind": "single-select",
          "options": [
            {
              "key": "description",
