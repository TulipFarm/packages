        {
          "key": "product",
          "label": "Product",
          "required": true,
          "kind": "relationship",
          "target": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "catalog-products"
          },
          "cardinality": "one",
          "inverseCardinality": "many",
