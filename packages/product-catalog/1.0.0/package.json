{
  "$schema": "https://tulipfarm.ai/schemas/system-package.v1.json",
  "formatVersion": 1,
  "package": {
    "name": "product-catalog",
    "version": "1.0.0",
    "title": "Product Catalog Data",
    "description": "Keep product records, variants and content checks in order before products go live, plus automations that mark products missing a description, open standard content checks and ask the owner to fix failed checks.",
    "license": "MIT"
  },
  "requires": {
    "platform": "tulipfarm-system-package-v1",
    "capabilities": [
      "tables",
      "seed-rows",
      "skills",
      "agents",
      "workflows"
    ]
  },
  "inputs": [
    {
      "key": "owning-team",
      "kind": "team",
      "title": "Owning team"
    },
    {
      "key": "package-manager",
      "kind": "member",
      "title": "Skill manager and automation sponsor"
    }
  ],
  "resources": [
