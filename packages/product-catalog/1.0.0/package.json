              "key": "throw"
            }
          ]
        },
        "sku": {
          "kind": "text",
          "value": "LTB-100-SGE"
        },
        "stock": {
          "kind": "single-select",
          "option": "pre-order"
        },
        "image-ready": {
          "kind": "boolean",
          "value": false
        }
      }
    },
    {
      "key": "check-desc",
      "kind": "seed-row",
      "table": {
        "kind": "resource",
        "resourceKind": "table",
        "key": "content-checks"
      },
      "values": {
        "title": {
          "kind": "text",
          "value": "Example: Description check"
        },
        "product": {
          "kind": "relationship",
          "rows": [
            {
              "kind": "resource",
              "resourceKind": "seed-row",
              "key": "throw"
            }
          ]
        },
        "check-type": {
          "kind": "single-select",
          "option": "description"
        },
        "result": {
          "kind": "single-select",
