        "status": {
          "kind": "single-select",
          "option": "committed"
        },
        "quarter": {
          "kind": "single-select",
          "option": "q4-2026"
        },
        "owner": {
          "kind": "text",
          "value": "Head of operations"
        },
        "level": {
          "kind": "single-select",
          "option": "company"
        },
        "why": {
          "kind": "text",
          "value": "Slow onboarding delays first invoices and drives early churn."
        }
