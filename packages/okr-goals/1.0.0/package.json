{
  "$schema": "https://tulipfarm.ai/schemas/system-package.v1.json",
  "formatVersion": 1,
  "package": {
    "name": "okr-goals",
    "version": "1.0.0",
    "title": "OKRs and Goals",
    "description": "Track quarterly objectives, their measurable key results and regular check-ins, plus automations that default new objectives to draft, flag missed check-ins and log an escalation when a key result goes off track.",
    "license": "MIT"
  },
  "requires": {
    "platform": "tulipfarm-system-package-v1",
    "capabilities": [
      "tables",
      "seed-rows",
      "skills",
      "agents",
      "workflows"
    ]
  },
