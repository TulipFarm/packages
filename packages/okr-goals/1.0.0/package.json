      ],
      "uniqueKeys": [],
      "sharing": {
        "grants": [
          {
            "team": {
              "kind": "input",
              "inputKind": "team",
              "key": "owning-team"
            },
            "permissions": [
              "table.row.read"
            ]
          }
        ],
        "personGrants": []
      }
    },
    {
      "key": "onboarding-time",
      "kind": "seed-row",
      "table": {
        "kind": "resource",
        "resourceKind": "table",
        "key": "objectives"
      },
      "values": {
        "title": {
          "kind": "text",
