          "maxLength": 2000
        },
        {
          "key": "level",
          "label": "Level",
          "required": false,
          "kind": "single-select",
          "options": [
            {
              "key": "company",
              "label": "Company",
              "retired": false
            },
            {
              "key": "team",
              "label": "Team",
              "retired": false
            },
            {
              "key": "individual",
              "label": "Individual",
              "retired": false
            }
          ]
        },
        {
          "key": "why",
          "label": "Why it matters",
          "required": false,
          "kind": "text",
          "maxLength": 10000
