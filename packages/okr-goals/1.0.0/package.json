      },
      "values": {
        "title": {
          "kind": "text",
          "value": "Example: Week 6 check-in on self-serve setup"
        },
        "key-result": {
          "kind": "relationship",
          "rows": [
            {
              "kind": "resource",
              "resourceKind": "seed-row",
