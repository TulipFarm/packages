        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "research-studies"
          },
          "permissions": [
            "table.row.read"
          ]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "research-sessions"
          },
          "permissions": [
            "table.row.read"
          ]
        }
      ],
      "taskLimits": {
        "toolCalls": 40,
        "activeMilliseconds": 180000,
        "credits": 100
      },
      "policy": {
