    {
      "key": "construction-punch-list-review",
      "kind": "workflow",
      "name": "Construction Punch List review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm the request describes the construction punch list records to review. This run reads records and proposes actions only.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "construction-punch-list-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": [
              "request"
            ]
          },
          "limits": {
            "toolCalls": 40,
            "activeMilliseconds": 180000,
            "credits": 100
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "flag-overdue-items",
      "kind": "workflow",
      "name": "Flag overdue punch items",
      "trigger": {
        "kind": "record",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "punch-items"
        },
        "field": {
          "kind": "date",
          "field": "due",
          "offset": {
            "direction": "after",
            "amount": 1,
            "unit": "days"
          },
          "time": "09:00",
          "timezone": {
            "kind": "input",
            "inputKind": "timezone",
            "key": "team-timezone"
          }
        },
        "filter": {
          "match": "is-not",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "signed-off"
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "punch-items"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "overdue",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "request-sign-off",
      "kind": "workflow",
      "name": "Request inspection and sign-off",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "punch-items"
        },
        "event": "updated",
        "fields": [
          "status"
        ],
        "filter": {
          "match": "is",
          "field": "status",
          "value": {
            "kind": "single-select",
            "option": "ready-for-inspection"
          }
        }
      },
      "steps": [
        {
          "id": "inspect",
          "kind": "human",
          "prompt": "A punch item is ready for inspection. Inspect it on site, then set it to signed off or rejected with a note.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    },
    {
      "key": "escalate-safety-items",
      "kind": "workflow",
      "name": "Escalate safety items",
      "trigger": {
        "kind": "row",
        "table": {
          "kind": "resource",
          "resourceKind": "table",
          "key": "punch-items"
        },
        "event": "updated",
        "fields": [
          "severity"
        ],
        "filter": {
          "match": "is",
          "field": "severity",
          "value": {
            "kind": "single-select",
            "option": "safety"
          }
        }
      },
      "steps": [
        {
          "id": "hold",
          "kind": "update-row",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "punch-items"
          },
          "row": {
            "kind": "input",
            "path": []
          },
          "fields": [
            {
              "field": "safety-hold",
              "value": {
                "kind": "table-value",
                "value": {
                  "kind": "boolean",
                  "value": true
                }
              }
            }
          ]
        },
        {
          "id": "make_safe",
          "kind": "human",
          "prompt": "A punch item was marked as a safety issue. Make the area safe, brief the trade contractor, and record the action on the item.",
          "timeoutSeconds": 86400
        }
      ],
      "sponsor": {
        "kind": "input",
        "inputKind": "member",
        "key": "package-manager"
      },
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": [
            "read"
          ]
        }
      ],
      "requestedState": "saved"
    }
