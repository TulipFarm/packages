                  "resourceKind": "table",
                  "key": "inbound-leads"
                },
                "field": "status",
                "option": "routed"
              }
            }
          ]
        },
        {
          "id": "accept",
          "kind": "human",
          "prompt": "A hot lead was routed to sales. Accept it, set yourself as owner and contact the lead within one working day.",
          "timeoutSeconds": 86400
        }
