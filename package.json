{
  "name": "@tulipfarm/packs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.3",
  "engines": { "node": ">=26.5.0" },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "validate": "tsx scripts/validate.ts",
