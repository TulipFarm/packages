    "sync-schemas": "tsx scripts/sync-schemas.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.0.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "yaml": "2.8.2"
  }
}
