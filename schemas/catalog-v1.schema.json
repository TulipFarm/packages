{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "packs"
  ],
  "properties": {
    "packs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "title",
          "description",
          "category",
          "version",
          "url"
        ],
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "maxLength": 4000,
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Sales",
              "IT Ops",
              "Marketing",
              "Document Ops",
              "Support",
              "Engineering"
            ]
          },
          "version": {
            "minimum": 1,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "url": {
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://",
            "type": "string"
          }
        }
      }
    }
  }
}
